# ===========================================
# Configuration de l'application
# ===========================================
# Copiez ce fichier en .env et remplissez les valeurs

# Port du serveur
PORT=3000

# Email (Gmail) pour les notifications
EMAIL_USER=no.reply.eveil.et.ihsan@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_application_gmail

# CORS - Origins autorisées (séparées par des virgules)
# En production, spécifiez les URLs exactes
# Exemple: ALLOWED_ORIGINS=https://ecole.example.com,https://www.ecole.example.com
ALLOWED_ORIGINS=

# Mode de l'application (development / production)
NODE_ENV=development
